# 계약봇 — 필요한 시크릿/식별자 목록
#
# 이 파일은 "어떤 값을 어디서 받아 어디에 입력해야 하는지" 한눈에 보기 위한
# 참고용입니다. 이 레포 자체는 코드를 실행하지 않으므로 실제 값을 여기에 채워
# 넣을 필요는 없습니다. 실제 값은 모두 n8n Cloud의 Credentials/Variables
# 영역에 저장합니다.

# ── Slack ──────────────────────────────────────────────────────────────
# api.slack.com/apps → 해당 앱 → "OAuth & Permissions" → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX

# api.slack.com/apps → 해당 앱 → "Basic Information" → App Credentials → Signing Secret
# (n8n에서 서명 검증을 추가로 하고 싶을 때 사용. 기본 워크플로는 사용하지 않음.)
SLACK_SIGNING_SECRET=

# ── Notion ─────────────────────────────────────────────────────────────
# notion.so/my-integrations → "계약봇 n8n" → Internal Integration Secret
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Notion DB URL의 ?앞 32자리. 예) https://www.notion.so/x/계약-관리-<여기>?v=...
NOTION_DATABASE_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── n8n Webhook URLs (워크플로 활성화 후 자동 생성) ──────────────────
# 워크플로 A의 "Slack 슬래시 커맨드 수신" 노드 Production URL
# → Slack 앱 매니페스트의 slash_commands.url 자리에 붙여넣음
N8N_WEBHOOK_URL_A=

# 워크플로 B의 "Slack Interactivity 수신" 노드 Production URL
# → Slack 앱 매니페스트의 settings.interactivity.request_url 자리에 붙여넣음
# 반드시 N8N_WEBHOOK_URL_A 와 다른 주소여야 함!
N8N_WEBHOOK_URL_B=
